#include <stdio.h>
#include <stdint.h>
#include <stdbool.h>
#include <unistd.h>
#include "system.h"

#define BASE     ((uintptr_t)RX_0_BASE)

#define RD(o)    (*((volatile uint32_t *)(BASE + ((o) << 2))))

#define FIFO      0x000u
#define IS_EMPTY  0x10Au

// debug counter
static uint32_t loop_cnt = 0;

// ===============================
// read register debug
// ===============================
static inline uint32_t rd_empty_raw()
{
    return RD(IS_EMPTY);
}

static inline uint8_t rd_fifo_raw()
{
    return (uint8_t)RD(FIFO);
}

// ===============================
// check FIFO empty (with log)
// ===============================
bool fifo_is_empty(void)
{
    uint32_t val = rd_empty_raw();

    // log nhẹ để không spam quá
    if (loop_cnt % 50 == 0) {
        printf("[DEBUG] IS_EMPTY raw = %u\n", val);
    }

    return (val & 0x1);
}

// ===============================
// read one byte (blocking + debug)
// ===============================
static uint8_t fifo_read(void)
{
    uint32_t wait_cnt = 0;

    while (fifo_is_empty())
    {
        wait_cnt++;

        if (wait_cnt % 100000 == 0) {
            printf("[WAIT] FIFO still empty... cnt=%u\n", wait_cnt);
        }
    }

    uint8_t data = rd_fifo_raw();
    printf("[READ] byte = 0x%02X\n", data);

    return data;
}

// ===============================
// dump FIFO
// ===============================
void fifo_dump(void)
{
    printf("========== FIFO DUMP START ==========\n");

    uint32_t byte_cnt = 0;

    while (!fifo_is_empty())
    {
        uint8_t b = fifo_read();
        printf("[FIFO %02u] 0x%02X\n", byte_cnt, b);
        byte_cnt++;
    }

    printf("========== FIFO DUMP END (%u bytes) ==========\n", byte_cnt);
}

// ===============================
// main
// ===============================
int main(void)
{
    printf("\n=== MAVLink RX FIFO Monitor (DEBUG MODE) ===\n");

    while (1)
    {
        loop_cnt++;

        uint32_t empty_raw = rd_empty_raw();

        // log trạng thái tổng
        if (loop_cnt % 20 == 0)
        {
            printf("\n[STATUS] loop=%u IS_EMPTY=%u FIFO=%02X\n",
                   loop_cnt,
                   empty_raw,
                   rd_fifo_raw());
        }

        // detect FIFO transition
        if (!fifo_is_empty())
        {
            printf("\n[EVENT] FIFO NOT EMPTY DETECTED!\n");

            fifo_dump();

            printf("[EVENT] DONE FRAME\n\n");
        }

        // small delay để tránh spam bus
        usleep(1000);
    }

    return 0;
}
