#include <stdio.h>
#include <unistd.h>

int main() {
    printf("================================\n");
    printf("  JTAG UART Demo - DE0-CV\n");

    int count = 0;

    while (1) {
        printf("[%d] Hello from FPGA!\n", count++);
        usleep(1000000);

        int c = getchar();
        if (c != EOF) {
            printf(">>> Received: '%c' (ASCII: %d)\n\n", (char)c, c);
        }
    }

    return 0;
}



