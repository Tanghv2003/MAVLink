#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include "system.h"
#include "altera_avalon_uart_regs.h"
#include "sys/alt_stdio.h"

#define MAV_BASE    TX_0_BASE
#define UART_BASE   UART_0_BASE

#define MAV_STX     0xFE
#define HDR_SIZE    6
#define CRC_SIZE    2

static inline void av_write(uint32_t base, uint32_t offset_byte, uint32_t val) {
    volatile uint32_t *p = (volatile uint32_t *)(base + offset_byte);
    *p = val;
}

static inline uint32_t av_read(uint32_t base, uint32_t offset_byte) {
    volatile uint32_t *p = (volatile uint32_t *)(base + offset_byte);
    return *p;
}

static int uart_rx_byte(void) {
    int timeout = 2000000;
    while (timeout--) {
        uint16_t status = IORD_ALTERA_AVALON_UART_STATUS(UART_BASE);
        if (status & ALTERA_AVALON_UART_STATUS_RRDY_MSK) {
            return (int)(IORD_ALTERA_AVALON_UART_RXDATA(UART_BASE) & 0xFF);
        }
    }
    return -1;
}

static int fifo_write(const uint8_t *data, uint8_t len) {
    for (int i = 0; i < len; i++) {
        if (av_read(MAV_BASE, 0x107 * 4) & 0x1) {
            alt_printf("  [ERR] FIFO full at byte %d\n", i);
            return -1;
        }
        av_write(MAV_BASE, 0x000, data[i]);
    }
    return 0;
}

static void mavlink_send(uint8_t sys_id,   uint8_t comp_id,
                         uint32_t msg_id,
                         uint8_t finc,     uint8_t fcmp,
                         const uint8_t *payload, uint8_t plen) {
    fifo_write(payload, plen);

    av_write(MAV_BASE, 0x100 * 4, plen);
    av_write(MAV_BASE, 0x101 * 4, finc);
    av_write(MAV_BASE, 0x102 * 4, fcmp);
    av_write(MAV_BASE, 0x103 * 4, sys_id);
    av_write(MAV_BASE, 0x104 * 4, comp_id);
    av_write(MAV_BASE, 0x105 * 4, msg_id & 0xFFFFFF);

    av_write(MAV_BASE, 0x106 * 4, 0x1);
}

static int wait_tx_done(void) {
    int timeout = 5000000;
    while (av_read(MAV_BASE, 0x109 * 4) & 0x1) {
        if (--timeout == 0) {
            alt_putstr("  [ERR] TX timeout!\n");
            return -1;
        }
    }
    return 0;
}

static int recv_frame(uint8_t *buf, int total) {
    for (int i = 0; i < total; i++) {
        int b = uart_rx_byte();
        if (b < 0) {
            alt_printf("  [ERR] RX timeout at byte %d\n", i);
            return -1;
        }
        buf[i] = (uint8_t)b;
    }
    return 0;
}

static void verify_frame(const uint8_t *frame, int total,
                         const uint8_t *payload, uint8_t plen,
                         uint8_t sys_id, uint8_t comp_id, uint32_t msg_id) {
    int pass = 1;

    alt_putstr("\n--- RAW FRAME ---\n");
    for (int i = 0; i < total; i++) {
        alt_printf("  [%02d] 0x%02X", i, frame[i]);
        if      (i == 0)                  alt_putstr("  <- STX");
        else if (i == 1)                  alt_putstr("  <- LEN");
        else if (i == 2)                  alt_putstr("  <- SEQ");
        else if (i == 3)                  alt_putstr("  <- SYS_ID");
        else if (i == 4)                  alt_putstr("  <- COMP_ID");
        else if (i == 5)                  alt_putstr("  <- MSG_ID");
        else if (i >= 6 && i < 6 + plen) alt_putstr("  <- PAYLOAD");
        else if (i == 6 + plen)           alt_putstr("  <- CRC_L");
        else if (i == 6 + plen + 1)       alt_putstr("  <- CRC_H");
        alt_putstr("\n");
    }

    alt_putstr("\n--- VERIFY ---\n");

    if (frame[0] == MAV_STX) {
        alt_putstr("  [OK]   STX    = 0xFE\n");
    } else {
        alt_printf("  [FAIL] STX    = 0x%02X (expect 0xFE)\n", frame[0]);
        pass = 0;
    }

    if (frame[1] == plen) {
        alt_printf("  [OK]   LEN    = %d\n", frame[1]);
    } else {
        alt_printf("  [FAIL] LEN    = %d (expect %d)\n", frame[1], plen);
        pass = 0;
    }

    if (frame[3] == sys_id) {
        alt_printf("  [OK]   SYS_ID = 0x%02X\n", frame[3]);
    } else {
        alt_printf("  [FAIL] SYS_ID = 0x%02X (expect 0x%02X)\n", frame[3], sys_id);
        pass = 0;
    }

    if (frame[4] == comp_id) {
        alt_printf("  [OK]   COMP_ID= 0x%02X\n", frame[4]);
    } else {
        alt_printf("  [FAIL] COMP_ID= 0x%02X (expect 0x%02X)\n", frame[4], comp_id);
        pass = 0;
    }

    if (frame[5] == (uint8_t)(msg_id & 0xFF)) {
        alt_printf("  [OK]   MSG_ID = 0x%02X\n", frame[5]);
    } else {
        alt_printf("  [FAIL] MSG_ID = 0x%02X (expect 0x%02X)\n",
                   frame[5], (uint8_t)(msg_id & 0xFF));
        pass = 0;
    }

    alt_putstr("  PAYLOAD: ");
    int payload_ok = 1;
    for (int i = 0; i < plen; i++) {
        alt_printf("0x%02X ", frame[6 + i]);
        if (frame[6 + i] != payload[i]) payload_ok = 0;
    }
    alt_putstr("\n");

    if (payload_ok) {
        alt_putstr("  [OK]   Payload matched\n");
    } else {
        alt_putstr("  [FAIL] Payload mismatch!\n");
        pass = 0;
    }

    alt_printf("  CRC: 0x%02X 0x%02X\n",
               frame[6 + plen], frame[6 + plen + 1]);

    alt_putstr("\n");
    if (pass) alt_putstr("  *** TEST PASSED ***\n");
    else      alt_putstr("  *** TEST FAILED ***\n");
}

static void run_test(const char *name,
                     uint8_t sys_id, uint8_t comp_id, uint32_t msg_id,
                     uint8_t finc, uint8_t fcmp,
                     const uint8_t *payload, uint8_t plen) {
    int total = HDR_SIZE + plen + CRC_SIZE;
    uint8_t frame[300];

    alt_printf("\n========== %s ==========\n", name);
    alt_printf("SYS=%d COMP=%d MSG=0x%X LEN=%d\n",
               sys_id, comp_id, msg_id, plen);

    mavlink_send(sys_id, comp_id, msg_id, finc, fcmp, payload, plen);

    if (wait_tx_done() < 0) return;

    alt_putstr("TX done, reading RX...\n");

    if (recv_frame(frame, total) < 0) return;

    verify_frame(frame, total, payload, plen, sys_id, comp_id, msg_id);
}

int main(void) {
    alt_putstr("\n");
    alt_putstr("================================\n");
    alt_putstr("  MAVLink Loopback Test (UART)  \n");
    alt_putstr("================================\n");

    uint32_t empty = av_read(MAV_BASE, 0x108 * 4);
    alt_printf("FIFO empty = %d (expect 1)\n", empty & 1);

    {
        uint8_t pl[] = {0xAA, 0xBB, 0xCC};
        run_test("TEST 1: Short payload (3 bytes)",
                 1, 1, 0x00, 0x00, 0x00,
                 pl, sizeof(pl));
    }

    {
        uint8_t pl[] = {0x01,0x02,0x03,0x04,0x05,0x06,0x07,0x08};
        run_test("TEST 2: 8-byte payload",
                 1, 1, 0x01, 0x00, 0x00,
                 pl, sizeof(pl));
    }

    {
        uint8_t pl[] = {0xFF, 0x00, 0x55, 0xAA};
        run_test("TEST 3: Different IDs",
                 0x42, 0x10, 0x05, 0x00, 0x00,
                 pl, sizeof(pl));
    }

    {
        uint8_t pl[] = {0xDE};
        run_test("TEST 4: Min payload (1 byte)",
                 1, 1, 0x00, 0x00, 0x00,
                 pl, sizeof(pl));
    }

    alt_putstr("\n========== ALL TESTS DONE ==========\n");
    return 0;
}
