#include <stdio.h>
#include <stdint.h>
#include "system.h"




#define FIFO            0x000
#define REG_PAYLOAD_LEN 0x101
#define REG_DATAV       0x108
#define REG_CLEAR_DV    0x109
#define IS_EMPTY        0x10A

int read(int addr){
	return *(int*) (RX_0_BASE + addr*4);
}

void delay2(int v){
	while(v--);
}
int main(void) {
    printf("\n=== MAVLink RX ===\n");

    while (1) {
    	printf("%d\n",read(IS_EMPTY));
    	printf("%d\n",read(FIFO));
    	printf("%d\n",read(REG_PAYLOAD_LEN));
    	delay2(100000);

    }
}
