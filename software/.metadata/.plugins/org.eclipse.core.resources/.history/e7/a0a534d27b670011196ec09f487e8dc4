#include <stdio.h>
#include "system.h"
#include <stdint.h>
#include <string.h>

#define TX_BASE  TX_0_BASE
#define RX_BASE  RX_0_BASE

#define RD(base, o)    (*((volatile uint32_t *)((base) + (o)*4)))
#define WR(base, o, v) (*((volatile uint32_t *)((base) + (o)*4)) = (v))

#define REG_FIFO        0x000
#define REG_FIFO_EMPTY  0x10A

#define MAVLINK_V2_STX       0xFD
#define MAVLINK_MAX_PAYLOAD  255

typedef struct {
    uint8_t  stx;
    uint8_t  len;
    uint8_t  incompat_flags;
    uint8_t  compat_flags;
    uint8_t  seq;
    uint8_t  sysid;
    uint8_t  compid;
    uint32_t msgid;
    uint8_t  payload[MAVLINK_MAX_PAYLOAD];
    uint16_t checksum;
} mavlink_v2_frame_t;

/* ------------------------------------------------------------------ */

static inline int fifo_empty(void) {
    return (RD(RX_BASE, REG_FIFO_EMPTY) & 1);
}

static inline uint8_t fifo_read_byte(void) {
    return (uint8_t)(RD(RX_BASE, REG_FIFO) & 0xFF);
}

/* Chờ có byte, không timeout — block mãi đến khi có dữ liệu */
static inline uint8_t wait_and_read(void) {
    while (fifo_empty());
    return fifo_read_byte();
}

/* CRC-16/MCRF4XX */
static uint16_t crc16_mcrf4xx(uint16_t crc, uint8_t byte) {
    uint8_t tmp = byte ^ (uint8_t)(crc & 0xFF);
    tmp ^= (tmp << 4);
    crc = (crc >> 8) ^ ((uint16_t)tmp << 8) ^ ((uint16_t)tmp << 3) ^ ((uint16_t)tmp >> 4);
    return crc;
}

static uint16_t mavlink_crc(const uint8_t *hdr9, const uint8_t *payload,
                             uint8_t payload_len, uint8_t crc_extra) {
    uint16_t crc = 0xFFFF;
    for (int i = 0; i < 9; i++)        crc = crc16_mcrf4xx(crc, hdr9[i]);
    for (int i = 0; i < payload_len; i++) crc = crc16_mcrf4xx(crc, payload[i]);
    crc = crc16_mcrf4xx(crc, crc_extra);
    return crc;
}

/* ------------------------------------------------------------------ */

int mavlink_v2_decode(mavlink_v2_frame_t *frame) {
    /* 1. Tìm STX */
    uint8_t byte;
    do { byte = wait_and_read(); } while (byte != MAVLINK_V2_STX);
    frame->stx = byte;

    /* 2. Đọc 9 bytes còn lại của header */
    uint8_t hdr[9];
    for (int i = 0; i < 9; i++) hdr[i] = wait_and_read();

    frame->len            = hdr[0];
    frame->incompat_flags = hdr[1];
    frame->compat_flags   = hdr[2];
    frame->seq            = hdr[3];
    frame->sysid          = hdr[4];
    frame->compid         = hdr[5];
    frame->msgid          = (uint32_t)hdr[6]
                          | ((uint32_t)hdr[7] << 8)
                          | ((uint32_t)hdr[8] << 16);

    if (frame->len > MAVLINK_MAX_PAYLOAD) {
        printf("FAIL: payload_len=%d vượt giới hạn\n", frame->len);
        return 0;
    }

    /* 3. Đọc payload */
    for (int i = 0; i < frame->len; i++)
        frame->payload[i] = wait_and_read();

    /* 4. Đọc checksum */
    uint8_t crc_lo = wait_and_read();
    uint8_t crc_hi = wait_and_read();
    frame->checksum = (uint16_t)crc_lo | ((uint16_t)crc_hi << 8);

    /* 5. Verify CRC — thay crc_extra đúng theo msg_id nếu có */
    uint8_t  crc_extra = 0x00;
    uint16_t crc_calc  = mavlink_crc(hdr, frame->payload, frame->len, crc_extra);
    if (crc_calc != frame->checksum)
        printf("WARN: CRC mismatch (calc=0x%04X, recv=0x%04X)\n", crc_calc, frame->checksum);

    return 1;
}

void mavlink_print_frame(const mavlink_v2_frame_t *f) {
    printf("--- Frame #%d ---\n",       f->seq);
    printf("  SYS=%-3d  COMP=%-3d  MSG_ID=0x%06X  LEN=%d\n",
           f->sysid, f->compid, f->msgid, f->len);
    printf("  CRC=0x%04X\n", f->checksum);
    printf("  Payload:");
    for (int i = 0; i < f->len; i++) {
        if (i % 16 == 0) printf("\n    ");
        printf("%02X ", f->payload[i]);
    }
    printf("\n");
}

/* ------------------------------------------------------------------ */

int main(void) {
    printf("=== MAVLink v2 Decoder — chờ frame liên tục ===\n");

    mavlink_v2_frame_t frame;

    while (1) {                          /* lặp mãi mãi */
        memset(&frame, 0, sizeof(frame));

        if (mavlink_v2_decode(&frame)) {
            mavlink_print_frame(&frame);
            /* TODO: xử lý frame theo frame.msgid tại đây */
        }
    }

    return 0;
}
