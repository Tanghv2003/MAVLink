#include <stdio.h>
#include "system.h"
#include <stdint.h>
#include <string.h>

#define RX_BASE  RX_0_BASE
#define RD(base, o)    (*((volatile uint32_t *)((base) + (o)*4)))
#define WR(base, o, v) (*((volatile uint32_t *)((base) + (o)*4)) = (v))

#define REG_FIFO         0x000
#define REG_PAYLOAD_LEN  0x101
#define REG_INCOMPAT     0x102
#define REG_COMPAT       0x103
#define REG_SYS_ID       0x104
#define REG_COMP_ID      0x105
#define REG_MSG_ID       0x106
#define REG_SEQ          0x107
#define REG_DATA_VALID   0x108
#define REG_CLEAR_VALID  0x109
#define REG_FIFO_EMPTY   0x10A

#define MAVLINK_MAX_PAYLOAD 255
#define MAVLINK_HEADER_LEN  10  /* STX+LEN+INC+CMP+SEQ+SYS+COMP+MSG(3) */
#define MAVLINK_CRC_LEN     2

typedef struct {
    /* Header */
    uint8_t  stx;           /* 0xFD        */
    uint8_t  payload_len;
    uint8_t  incompat_flags;
    uint8_t  compat_flags;
    uint8_t  seq;
    uint8_t  sysid;
    uint8_t  compid;
    uint32_t msgid;         /* 24-bit      */
    /* Payload */
    uint8_t  payload[MAVLINK_MAX_PAYLOAD];
    /* CRC */
    uint16_t checksum;
    /* Raw */
    uint8_t  raw[MAVLINK_HEADER_LEN + MAVLINK_MAX_PAYLOAD + MAVLINK_CRC_LEN];
    uint16_t raw_len;
} mavlink_frame_t;

/* ------------------------------------------------------------------ */

static inline int  data_valid(void) { return (RD(RX_BASE, REG_DATA_VALID) & 1); }
static inline int  fifo_empty(void) { return (RD(RX_BASE, REG_FIFO_EMPTY) & 1); }
static inline void clear_valid(void){ WR(RX_BASE, REG_CLEAR_VALID, 1); }

static inline uint8_t read_fifo_byte(void) {
    while (fifo_empty());
    return (uint8_t)(RD(RX_BASE, REG_FIFO) & 0xFF);
}

/* ------------------------------------------------------------------ */

int read_frame(mavlink_frame_t *f) {
    /* Lấy payload_len từ thanh ghi để biết tổng số byte cần đọc */
    uint8_t plen = (uint8_t)(RD(RX_BASE, REG_PAYLOAD_LEN) & 0xFF);
    uint16_t total = MAVLINK_HEADER_LEN + plen + MAVLINK_CRC_LEN;
                  /* = 10 + N + 2 */

    /* Đọc toàn bộ raw frame từ FIFO */
    for (int i = 0; i < total; i++)
        f->raw[i] = read_fifo_byte();
    f->raw_len = total;

    /* Parse từ raw */
    f->stx           = f->raw[0];   /* 0xFD */
    f->payload_len   = f->raw[1];
    f->incompat_flags= f->raw[2];
    f->compat_flags  = f->raw[3];
    f->seq           = f->raw[4];
    f->sysid         = f->raw[5];
    f->compid        = f->raw[6];
    f->msgid         = (uint32_t)f->raw[7]
                     | ((uint32_t)f->raw[8] << 8)
                     | ((uint32_t)f->raw[9] << 16);

    memcpy(f->payload, &f->raw[10], plen);

    f->checksum = (uint16_t)f->raw[10 + plen]
                | ((uint16_t)f->raw[11 + plen] << 8);

    clear_valid();
    return 1;
}

/* ------------------------------------------------------------------ */

void print_frame(const mavlink_frame_t *f, int count) {
    printf("=== Frame #%d ===\n", count);
    printf("  STX     : 0x%02X\n",   f->stx);
    printf("  SEQ     : %d\n",       f->seq);
    printf("  SYS_ID  : %d\n",       f->sysid);
    printf("  COMP_ID : %d\n",       f->compid);
    printf("  MSG_ID  : 0x%06X\n",   f->msgid);
    printf("  LEN     : %d\n",       f->payload_len);
    printf("  CRC     : 0x%04X\n",   f->checksum);
    printf("  Payload :");
    for (int i = 0; i < f->payload_len; i++) {
        if (i % 16 == 0) printf("\n    ");
        printf("%02X ", f->payload[i]);
    }
    printf("\n");

    printf("  Raw     :");
    for (int i = 0; i < f->raw_len; i++) {
        if (i % 16 == 0) printf("\n    ");
        printf("%02X ", f->raw[i]);
    }
    printf("\n");
}

/* ------------------------------------------------------------------ */

int main(void) {
    printf("=== MAVLink v2 Decoder ===\n");

    mavlink_frame_t frame;
    int count = 0;

    while (1) {
        if (!data_valid()) continue;

        memset(&frame, 0, sizeof(frame));
        read_frame(&frame);
        count++;
        print_frame(&frame, count);
    }

    return 0;
}
