#include <stdio.h>
#include "system.h"
#include <stdint.h>
#define TX_BASE  TX_0_BASE
#define RX_BASE  RX_0_BASE
#define RD(base, o)   (*((volatile uint32_t *)((base) + (o)*4)))
#define WR(base, o,v) (*((volatile uint32_t *)((base) + (o)*4)) = (v))

int main(void) {
    printf("=== Loopback Test ===\n");

    // Gửi 1 frame MAVLink qua TX
    // Đọc lại từ RX
    // Nếu dataValid lên → loopback thành công

    int timeout = 1000000;
    while (!(RD(RX_BASE, 0x108) & 1) && timeout--);

    if (timeout <= 0) {
        printf("FAIL: Timeout, no frame received\n");
    } else {
        printf("PASS: Frame received!\n");
        printf("payload_len = %d\n", (int)(RD(RX_BASE, 0x101) & 0xFF));
        printf("sys_id      = %d\n", (int)(RD(RX_BASE, 0x104) & 0xFF));
        printf("msg_id      = 0x%06X\n", (int)(RD(RX_BASE, 0x106) & 0xFFFFFF));
        WR(RX_BASE, 0x109, 1);
    }
    return 0;
}
