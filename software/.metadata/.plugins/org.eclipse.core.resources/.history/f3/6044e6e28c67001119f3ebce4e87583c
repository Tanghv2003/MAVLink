#include <stdio.h>
#include "system.h"
#include <stdint.h>
#include <string.h>
#include "rx.h"



int main(void) {
    printf("=== MAVLink v22 Decoder ===\n");

    Frame frame;
    int count = 0;

    while (1) {
        /* Chờ hardware push xong toàn bộ frame vào FIFO */
        if (!data_valid()) continue;

        memset(&frame, 0, sizeof(frame));
        read_frame(&frame);
        count++;
        print_frame(&frame, count);
    }

    return 0;
}
