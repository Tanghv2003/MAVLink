#include <stdio.h>
#include <string.h>
#include "system.h"

#define LED_ADDR  LEDS_0_BASE
#define LED_ON    0x3FF
#define LED_OFF   0x000

void led_write(unsigned int v) {
    *((volatile unsigned int *) LED_ADDR) = v;
}

int main() {
    char buf[8];
    printf("Hello from Nios II!\n");
    printf("1: all on | 2: all off\n");
    led_write(LED_OFF);

    while (1) {
        printf("> ");
        fflush(stdout);
        fgets(buf, sizeof(buf), stdin);

        if (buf[0] == '1') {
            led_write(LED_ON);
            printf("LED ON\n");
        } else if (buf[0] == '2') {
            led_write(LED_OFF);
            printf("LED OFF\n");
        } else {
            printf("1: on | 2: off\n");
        }
    }
    return 0;
}
