#include <stdio.h>
#include "rx.h"

void delay(int v){
	while(v--);
}
int main()
{
  printf("Hello from Nios 3!\n");
  SetLed(17);
  Frame f;
  //flushFifo();
  clear();
  while(1){
	  //printf("valid=%d empty=%d\n", data_Valid(), fifo_Empty());
	  readFrame(&f);
	  delay(200);
  }
  return 0;
}
