#include "tx.h"


void write(int * addr, int value){
	*(TX_0_BASE+ addr) = value;
}
bool wait_done(){
	return (*(int*) ADDR_BUSY_REG ) & 0x01;
}
bool is_full(){
	return (*(int*) ADDR_FIFO_FULL) & 0x01;
}
void send_frame(char *payload, int len, int sys_id, int comp_id, int msg_id, int inc_flags, int cmp_flags){
	while(wait_done()){
		if(!is_full){

			write(ADDR_PAYLOAD_LEN, len);
			write(ADDR_INC_FLAGS, inc_flags);
			write(ADDR_COM_FLAGS, cmp_flags);
			write(ADDR_SYSID, sys_id);
			write(ADDR_COMPID, comp_id);
			write(ADDR_MSGID, msg_id & 0x00FFFFFF);//24 byte

			int i;
			for(int i = 0; i < len; i++){
				write(ADDR_FIFO, payload[i]);
			}
			write(ADDR_START, 1);
			while(wait_done());
		}
	}
}

